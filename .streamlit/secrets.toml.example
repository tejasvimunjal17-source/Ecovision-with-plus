# .streamlit/secrets.toml.example
#
# PHASE 3B — Google OIDC (Streamlit native auth: st.login()/st.user).
# Copy this file to .streamlit/secrets.toml and fill in your own real
# values there. NEVER commit the real .streamlit/secrets.toml file
# (it's already covered by this repo's .gitignore) — every value below
# is a placeholder, not a working credential.
#
# EcoVision AI calls st.login() with no provider name (see app.py's
# "Continue with Google" button and supabase/README.md's "Google OIDC
# configuration" section for the full walkthrough), which means all of
# these settings go directly under the single [auth] table below — NOT
# a named [auth.google] sub-table (that layout is only for apps
# offering more than one OIDC provider at once, which EcoVision does
# not).
#
# If this [auth] table is left unset/misconfigured entirely, that's a
# supported, safe state: app.py's google_signed_in() check and the
# "Continue with Google" button's try/except both fail closed —
# "Continue with Email" and every other part of the app work exactly
# as if this file didn't exist.

[auth]
# Your app's absolute URL with the pathname "oauth2callback" appended —
# this exact value must ALSO be registered as an authorized redirect
# URI on the Google Cloud OAuth client (see supabase/README.md).
# Local development default:
redirect_uri = "http://localhost:8501/oauth2callback"

# A strong, randomly generated secret used to sign the identity cookie
# Streamlit stores in the visitor's browser after login. Generate one
# yourself, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Do not reuse this example value.
cookie_secret = "REPLACE_WITH_YOUR_OWN_RANDOM_SECRET"

# From Google Cloud Console -> APIs & Services -> Credentials -> your
# OAuth 2.0 Client ID (see supabase/README.md for the full setup steps).
client_id = "REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Fixed value for Google (the same for every Google Cloud project —
# not something you generate yourself):
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
