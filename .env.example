# ==============================================================
# EcoVision AI — Smart Waste Management Platform
# Environment Variables Template
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to GitHub.
# ==============================================================

# ---- OpenRouter AI ----
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_SITE_URL=https://ecovision-ai.streamlit.app
OPENROUTER_APP_NAME=EcoVision AI

# ---- App / Security ----
APP_SECRET_KEY=change_this_to_a_long_random_string
SESSION_TIMEOUT_MINUTES=60

# ---- Database (Phase 2B: Supabase / PostgreSQL — see supabase/README.md) ----
# SUPABASE_DB_URL is the ONE required credential: a direct Postgres
# connection string from your Supabase project (Project Settings ->
# Database -> Connection string -> "URI"). database/db.py connects with
# this directly (via psycopg2) so every existing raw SQL query in the
# app keeps working unchanged — see supabase/README.md for why.
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are captured for future
# features that would use Supabase's REST API/SDK directly (e.g.
# Supabase Storage for complaint photos) — NOT used by database/db.py
# in Phase 2B. Safe to leave blank for now.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# DATABASE_PATH (SQLite) — no longer used by database/db.py as of Phase
# 2B; kept only so nothing referencing settings.DATABASE_PATH elsewhere
# breaks. Safe to leave as-is or remove once you're fully on Supabase.
DATABASE_PATH=database/ecovision.db

# ---- Google OIDC ("Continue with Google", Phase 3B) ----
# NOT configured here. Streamlit's native st.login() reads its config
# from .streamlit/secrets.toml, not from .env / os.environ — copy
# .streamlit/secrets.toml.example to .streamlit/secrets.toml (already
# gitignored) and see supabase/README.md's "Google OIDC configuration"
# section for the full setup walkthrough.

# ---- Municipality Branding ----
MUNICIPALITY_NAME=Municipal Corporation of Gurugram (MCG)
SUPPORT_EMAIL=support@ecovision-ai.example.in
SUPPORT_PHONE=+91-9999999999
